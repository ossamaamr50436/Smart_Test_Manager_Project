# قاعدة بيانات Neon (PostgreSQL)
DATABASE_URL="postgresql://user:password@ep-xxxx.ap-1.aws.neon.tech/exam-platform?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="أنشئ مفتاحاً عشوائياً آمناً"
NEXTAUTH_URL="http://localhost:3000"

# Google Drive API (حساب خدمة)
GOOGLE_CLIENT_EMAIL="service-account@exam-platform.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_FOLDER_ID="1AbC123...FolderId"
# اختياري: مجلد منفصل لنماذج الاختبارات على Drive
# GOOGLE_DRIVE_MODELS_FOLDER_ID="..."

# التواصل عبر واتساب (رقم الدعم الفني بصيغة دولية بدون + أو أصفار بادئة)
# مثال لرقم: 966501234567
NEXT_PUBLIC_WHATSAPP_NUMBER="966501234567"

# طابور المهام الإنتاجي (BullMQ + Redis) — اختياري محلياً
# إن لم يُضبط، يعمل الخادم المصغّر بوضع الذاكرة التدهوري
# REDIS_URL="rediss://default:password@host:port"

# ------------------------------------------------------------------
# بذر قاعدة البيانات (Seed) — حسابات الأدمن (اختياري، استخدام آمن)
# ------------------------------------------------------------------
# تُقرأ بيانات الأدمن من المتغيرات البيئية بدلاً من الكود المصدري.
# كلمة مرور الأدمن يجب أن تكون 12 حرفاً على الأقل.
# ADMIN_EMAIL="admin@example.com"
# ADMIN_PASSWORD="ضع-كلمة-مرور-قوية-جداً-هنا"
# ADMIN_NAME="المسؤول العام"
# ADMIN_BIRTH_DATE="1990-01-01"

# ------------------------------------------------------------------
# الخدمة المصغّرة (Express Microservice) — أمان
# ------------------------------------------------------------------
# مفتاح API داخلي مطلوب للوصول إلى نقاط الطابور الحساسة
# (احتفظ به سراً، قيّده مع INTERNAL_API_KEY في Next.js للإستدعاء)
# INTERNAL_API_KEY="generate-a-long-random-secret"

# النطاقات المسموحة لـ CORS (افصل بفواصل)
# مثال لبيئة إنتاج: https://app.example.com
# ALLOWED_ORIGINS="https://example.vercel.app"