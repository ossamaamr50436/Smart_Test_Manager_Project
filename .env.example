# Google Drive API (حساب خدمة)
GOOGLE_CLIENT_EMAIL="service-account@exam-platform.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_FOLDER_ID="1AbC123...FolderId"
