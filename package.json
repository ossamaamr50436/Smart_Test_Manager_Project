{
    "name":  "exam-test-manager-platform",
    "version":  "0.1.0",
    "private":  true,
    "scripts":  {
                    "dev":  "next dev --turbo",
                    "build":  "next build",
                    "start":  "next start",
                    "lint":  "next lint",
                    "typecheck":  "tsc --noEmit",
                    "prisma:generate":  "prisma generate",
                    "prisma:migrate":  "prisma migrate dev",
                    "prisma:push":  "prisma db push",
                    "prisma:studio":  "prisma studio",
                    "db:seed":  "tsx prisma/seed.ts",
                    "fix:users":  "tsx scripts/apply-user-fixes.ts",
                    "server":  "node server/index.js",
                    "dev:all":  "concurrently -n next,express -c blue,yellow \"next dev\" \"node server/index.js\"",
                    "test:security":  "tsx --test tests/security/*.test.ts",
                    "test:unit":  "vitest run --reporter=basic",
                    "test:integration":  "tsx --test tests/integration/*.test.ts",
                    "test:e2e":  "playwright test",
                    "e2e:install":  "playwright install chromium",
                    "test:load":  "tsx scripts/load-test.ts",
                    "test":  "pnpm test:unit \u0026\u0026 pnpm test:security \u0026\u0026 pnpm test:integration",
                    "postinstall":  "prisma generate"
                },
