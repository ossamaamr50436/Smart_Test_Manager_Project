// ============================================================
// تطبيق الاختبارات
// Prisma Schema — PostgreSQL (Neon)
// إعادة تصميم اللجان + إعدادات التقييم
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------
// الأدوار (Enums)
// ------------------------------------------------------------
enum Role {
  SUPER_ADMIN // جديد — مالك المنصة (بدون tenantId)
  ADMIN // المسؤول
  HEAD_OF_AFFAIRS // رئيس الشؤون التعليمية
  CERTIFICATE_SOURCE // مصدر الشهادات
  TEST_SPECIALIST // أخصائي الاختبارات
  EXAMINER // المختبر
  INSTITUTION // الجهة التعليمية
}

enum StudentStatus {
  PENDING // بانتظار المراجعة
  APPROVED // مقبول
  REJECTED // مرفوض
  ASSIGNED // تم توزيعه على لجنة
  COMPLETED // اكتمل تقييمه واعتماده المتسلسل
  NOTIFIED // اعتمد الأخصائي (بانتظار اعتماد رئيس الشؤون)
  READY_FOR_CERTIFICATE // جاهز لإصدار الشهادة
  CERTIFICATE_ISSUED // صدرت شهادته
}

enum ExamSessionStatus {
  SCHEDULED // تم تحديد الموعد
  IN_PROGRESS // جارٍ التقييم
  COMPLETED // اكتمل التقييم
  CANCELLED // ملغى
}

enum AssessmentStatus {
  DRAFT // تقييم أولي قيد التحرير
  APPROVED // اعتمده المختبر — حالة الاعتماد النهائية لتقييم المختبر
  FINALIZED // حالة محفوظة للتوافق مع البيانات القديمة
  ACCEPTED // اعتمده الأخصائي
  NOTIFIED // وافق عليه رئيس الشؤون
}

enum CertificateStatus {
  PENDING // بانتظار التوقيع
  SIGNED // تم التوقيع
  UPLOADED // تم رفعه إلى وحدة التخزين
  SENT // أُرسل للجهة
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  RECRUITMENT // ترشيح جديد
  APPROVAL // موافقة/رفض
  SCHEDULE // تحديد موعد
  ASSESSMENT // تقييم
  CERTIFICATE // شهادة
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  APPROVE
  REJECT
  ASSESS
  SUSPICIOUS_ACCESS
  RATE_LIMIT_HIT
  CROSS_TENANT_ATTEMPT
  FAILED_LOGIN
}

// ------------------------------------------------------------
// Multi-Tenant — المؤسسات/الجمعيات
// ------------------------------------------------------------
model Tenant {
  id             String   @id @default(cuid())
  name           String   @unique
  slug           String   @unique
  uploadthingToken     String? // مفتاح UploadThing (sk_live_...) — يُعرض للمالك
  uploadthingTokenHash String? // SHA256 من المفتاح للتحقق الآمن دون كشفه
  primaryColor         String   @default("#015e63")
  secondaryColor String   @default("#d3bb8b")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  users              User[]
  institutions       Institution[]
  students           Student[]
  examSeasons        ExamSeason[]
  committees         Committee[]
  examSessions       ExamSession[]
  assessments        Assessment[]
  certificates       Certificate[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  assessmentSettings AssessmentSettings[]
  questionBankModels QuestionBankModel[]

  @@index([uploadthingTokenHash])
  @@map("tenants")
}

// ------------------------------------------------------------
// المستخدمون
// ------------------------------------------------------------
model User {
  id                 String   @id @default(cuid())
  name               String
  email              String   @unique
  password           String // مشفرة بـ bcrypt
  role               Role
  birthDate          DateTime // تاريخ الميلاد (بيانات تعريفية)
  phone              String? // رقم الجوال — يُستخدم في قناة إشعارات SMS
  mustChangePassword Boolean  @default(false) // إجبار المستخدم على تغيير كلمة المرور بعد أول دخول
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  institutionId      String? // للمستخدمين من نوع Institution فقط (عزل الصلاحيات)
  tenantId           String? // Multi-Tenant — nullable لأن SUPER_ADMIN ليس له tenant

  tenant               Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  institution          Institution?   @relation(fields: [institutionId], references: [id])
  auditLogs            AuditLog[]     @relation("UserAuditLogs")
  notifications        Notification[]
  sentNotifications    Notification[] @relation("NotificationSender")
  sessionsAsTeacher1   ExamSession[]  @relation("Teacher1")
  sessionsAsTeacher2   ExamSession[]  @relation("Teacher2")
  committeesAsTeacher1 Committee[]    @relation("CommitteeTeacher1")
  committeesAsTeacher2 Committee[]    @relation("CommitteeTeacher2")
  assessments          Assessment[]
  certificatesIssued   Certificate[]  @relation("CertificateIssuer")
  studentNominations   Student[]      @relation("StudentNominations")

  @@index([institutionId])
  @@index([tenantId])
  @@map("users")
}

// ------------------------------------------------------------
// الجهات التعليمية
// ------------------------------------------------------------
model Institution {
  id              String  @id @default(cuid())
  name            String
  managerName     String // اسم مدير الجهة
  supervisorName  String // اسم مشرف الجهة
  managerPhone    String // رقم هاتف مدير الجهة
  supervisorPhone String // رقم هاتف مشرف الجهة
  licenseNumber   String  @unique // رقم التصريح (فريد — يُستخدم أيضاً كبديل مؤقت لكلمة المرور)
  district        String // الحي
  contactInfo     String?
  credentials     String? // معرف/كلمة مرور خاصة بالجهة
  tenantId        String // Multi-Tenant

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users      User[]
  students   Student[]

  @@index([licenseNumber])
  @@index([tenantId])
  @@map("institutions")
}

// ------------------------------------------------------------
// الطلاب
// ------------------------------------------------------------
model Student {
  id            String        @id @default(cuid())
  name          String
  age           Int
  branch        String // الفرع: 5/10/15/20/25/30 جزء
  nationality   String        @default("السعودية") // الجنسية (المهمة 3)
  teacherName   String
  parentPhone   String
  address       String?
  phone         String?
  status        StudentStatus @default(PENDING)
  institutionId String
  committeeId   String? // اللجنة المرتبطة بالطالب (المهمة 1)
  submittedById String? // من رشّح الطالب (أخصائي أو مستخدم جهة) — null تعني الجهة نفسها
  approvedAt    DateTime? // تاريخ القبول
  assignedAt    DateTime? // تاريخ التوزيع على لجنة
  finalizedAt   DateTime? // تاريخ الاعتماد النهائي
  tenantId      String // Multi-Tenant
  createdAt     DateTime      @default(now()) // تاريخ الترشيح
  updatedAt     DateTime      @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  institution  Institution   @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  committee    Committee?    @relation(fields: [committeeId], references: [id])
  submittedBy  User?         @relation("StudentNominations", fields: [submittedById], references: [id])
  examSessions ExamSession[]
  certificates Certificate[]

  // ملف ترشيح الطالب (PDF) — يُرفع إلى وحدة التخزين (UploadThing)
  applicationFileId  String? // معرف الملف في وحدة التخزين
  applicationFileUrl String? // رابط العرض للملف

  @@index([institutionId])
  @@index([committeeId])
  @@index([status])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, institutionId])
  @@index([tenantId, committeeId])
  @@index([tenantId, submittedById])
  @@index([tenantId, createdAt])
  @@map("students")
}

// ------------------------------------------------------------
// مواسم الاختبارات (Seasons)
// ------------------------------------------------------------
model ExamSeason {
  id        String   @id @default(cuid())
  name      String // مثال: "1446-الفصل الأول"
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)
  tenantId  String // Multi-Tenant
  createdAt DateTime @default(now())

  tenant     Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions   ExamSession[]
  committees Committee[]

  @@index([tenantId])
  @@map("exam_seasons")
}

// ------------------------------------------------------------
// اللجان (Committee) — المهمة 1
// ------------------------------------------------------------
model Committee {
  id         String   @id @default(cuid())
  name       String // اسم اللجنة (مثال: "لجنة 1 — فرع 5 أجزاء")
  branch     String // الفرع: 5/10/15/20/25/30 جزءاً
  seasonId   String
  teacher1Id String // المختبر الأول في اللجنة
  teacher2Id String // المختبر الثاني في اللجنة
  tenantId   String // Multi-Tenant
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant      Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  season      ExamSeason                 @relation(fields: [seasonId], references: [id])
  teacher1    User                       @relation("CommitteeTeacher1", fields: [teacher1Id], references: [id])
  teacher2    User                       @relation("CommitteeTeacher2", fields: [teacher2Id], references: [id])
  students        Student[]
  selectedModels  CommitteeModelSelection[]

  @@unique([tenantId, name, seasonId])
  @@index([seasonId])
  @@index([branch])
  @@index([tenantId])
  @@map("committees")
}

// ------------------------------------------------------------
// بنك الأسئلة — النماذج دائمة (بلا موسم) على مستوى المستأجر
// المصدر الوحيد للنماذج — لا تُقيَّد بموسم أو لجنة (المهمة I)
// ------------------------------------------------------------
model QuestionBankModel {
  id            String @id @default(cuid())
  modelNumber   Int // 1-100 لكل فرع
  branch        String // الفرع: 5/10/15/20/25/30 جزءاً
  detailsJSON   Json // المقاطع — حتى 30 مقطعاً
  segmentsCount Int    @default(10)
  tenantId      String // Multi-Tenant

  tenant              Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions            ExamSession[]
  assessments         Assessment[]
  committeeSelections CommitteeModelSelection[]

  @@unique([tenantId, modelNumber, branch])
  @@index([tenantId])
  @@index([tenantId, branch])
  @@map("question_bank_models")
}

// ------------------------------------------------------------
// جلسات الاختبار
// اللجنة = معلمان: teacher1 و teacher2 (يعملان بشكل مستقل)
// ------------------------------------------------------------
model ExamSession {
  id         String            @id @default(cuid())
  studentId  String
  teacher1Id String // المقيّم الأول
  teacher2Id String // المقيّم الثاني
  examDate   DateTime
  period     String // صباحي / مسائي
  status     ExamSessionStatus @default(SCHEDULED)
  seasonId   String // الموسم الذي تنتمي إليه الجلسة
  modelId    String? // النموذج المختار للأداء
  tenantId   String // Multi-Tenant
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student  Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher1 User       @relation("Teacher1", fields: [teacher1Id], references: [id])
  teacher2 User       @relation("Teacher2", fields: [teacher2Id], references: [id])
  season   ExamSeason        @relation(fields: [seasonId], references: [id])
  model    QuestionBankModel? @relation(fields: [modelId], references: [id])

  assessments   Assessment[]
  notifications Notification[]

  @@unique([seasonId, modelId])
  @@index([studentId])
  @@index([teacher1Id])
  @@index([teacher2Id])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, examDate])
  @@index([tenantId, teacher1Id])
  @@index([tenantId, teacher2Id])
  @@map("exam_sessions")
}

// ------------------------------------------------------------
// النماذج المختارة يدوياً للجنة (many-to-many Committee <-> QuestionBankModel)
// بدل النطاق الرقمي السابق (CommitteeModelAllocation) — بلا ترتيب ولا نطاق
// ------------------------------------------------------------
model CommitteeModelSelection {
  id          String   @id @default(cuid())
  committeeId String
  modelId     String // نموذج من بنك الأسئلة (QuestionBankModel)
  createdAt   DateTime @default(now())

  committee Committee         @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  model     QuestionBankModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([committeeId, modelId])
  @@index([modelId])
  @@map("committee_model_selections")
}

// ------------------------------------------------------------
// إعدادات التقييم (Singleton) — المهمة 6
// يضبطها الأخصائي — تحكم خصومات الأخطاء والشك والتجويد
// ------------------------------------------------------------
model AssessmentSettings {
  id               String   @id @default("singleton")
  errorDeduction   Float    @default(2.0) // خصم لكل خطأ
  doubtDeduction   Float    @default(1.0) // خصم لكل شك
  tajweedDeduction Float    @default(0.5) // خصم لكل تجويد
  tenantId         String   @unique // Multi-Tenant — إعداد واحد لكل Tenant
  updatedAt        DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("assessment_settings")
}

// ------------------------------------------------------------
// التقييمات — وفق لائحة اختيار فرع كامل القرآن (100 درجة)
// الحفظ (70) + التنبيه + الشك + التلاوة (20) + التجويد (10)
// ------------------------------------------------------------
model Assessment {
  id            String @id @default(cuid())
  examSessionId String
  evaluatorId   String // المقيّم الحالي
  modelId       String // النموذج المختار

  // الحفظ (70 درجة) — خصم من الدرجة القصوى
  wordErrors      Int @default(0) // أخطاء الكلمات — خصم 1 لكل خطأ
  letterErrors    Int @default(0) // أخطاء الحروف — خصم 1 لكل خطأ
  diacriticErrors Int @default(0) // أخطاء الضبط — خصم 1 لكل خطأ
  seriousErrors   Int @default(0) // اللحن الجلي — خصم 2 لكل خطأ
  subtleErrors    Int @default(0) // اللحن الخفي — خصم 0.5 لكل خطأ

  // التنبيه (يُخصم عند الحاجة)
  promptingCount Int @default(0) // عدد مرات التنبيه — خصم 1 لكل تنبيه

  // الشك (التردد)
  doubtCount Int @default(0) // عدد مرات الشك — خصم 0.5 لكل شك

  // أخطاء التجويد (المهمة 6 — بدلاً من الاعتماد على tajweedScore فقط)
  tajweedErrors Int @default(0) // عدد أخطاء التجويد — خصم tajweedDeduction لكل خطأ

  // التلاوة وحسن الأداء (20 درجة) — تُقيّم من المختبر مباشرة
  recitationScore Float @default(0) // من 0 إلى 20

  // التجويد التطبيقي (10 درجات) — تُقيّم من المختبر مباشرة
  tajweedScore Float @default(0) // من 0 إلى 10

  // الدرجات المحسوبة
  memorizationDeduction Float            @default(0) // إجمالي خصم الحفظ
  totalDeduction        Float            @default(0) // إجمالي جميع الخصومات
  finalScore            Float            @default(0) // الدرجة النهائية من 100
  isFinalApproved       Boolean          @default(false)
  status                AssessmentStatus @default(DRAFT)
  tenantId              String // Multi-Tenant
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  examSession ExamSession @relation(fields: [examSessionId], references: [id], onDelete: Cascade)
  evaluator   User        @relation(fields: [evaluatorId], references: [id])
  model       QuestionBankModel @relation(fields: [modelId], references: [id])

  // منع تقييمين لنفس المقيّم في جلسة واحدة
  @@unique([examSessionId, evaluatorId])
  @@index([examSessionId])
  @@index([evaluatorId])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, examSessionId])
  @@map("assessments")
}

// ------------------------------------------------------------
// الشهادات
// ------------------------------------------------------------
model Certificate {
  id              String            @id @default(cuid())
  serialNumber    String            @unique // رقم تسلسلي فريد للشهادة
  studentId       String
  finalScore      Float
  fileUrl         String? // رابط الملف في وحدة التخزين
  fileId          String? // معرف ملف الشهادة في وحدة التخزين
  signatureFileId String? // معرف ملف التوقيع في وحدة التخزين
  issuedDate      DateTime? // تاريخ الإصدار
  status          CertificateStatus @default(PENDING)
  issuedById      String?
  signatureUrl    String? // رابط صورة التوقيع الرقمي
  signedById      String? // معرف الموقّع
  signedAt        DateTime?
  tenantId        String // Multi-Tenant
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student  Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  issuedBy User?   @relation("CertificateIssuer", fields: [issuedById], references: [id])

  @@index([studentId])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("certificates")
}

// ------------------------------------------------------------
// الإشعارات
// ------------------------------------------------------------
model Notification {
  id            String           @id @default(cuid())
  userId        String
  message       String
  type          NotificationType @default(INFO)
  isRead        Boolean          @default(false)
  examSessionId String?
  tenantId      String? // Multi-Tenant — nullable لسجلات مستوى المنصة (SUPER_ADMIN)
  senderId      String? // مُرسل الإشعار (SUPER_ADMIN عند التنبيهات العامة)
  createdAt     DateTime         @default(now())

  tenant      Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User?        @relation(fields: [userId], references: [id])
  sender      User?        @relation("NotificationSender", fields: [senderId], references: [id])
  examSession ExamSession? @relation(fields: [examSessionId], references: [id])

  @@index([userId])
  @@index([isRead])
  @@index([tenantId])
  @@index([userId, isRead, tenantId])
  @@map("notifications")
}

// ------------------------------------------------------------
// إعدادات المنصة (Singleton)
// ------------------------------------------------------------
model AppSettings {
  id                            String   @id @default("singleton")
  platformName                  String   @default("تطبيق الاختبارات")
  logoFileId                    String? // معرف ملف الشعار في وحدة التخزين
  logoUrl                       String? // رابط الشعار العام
  useTemplateMode               Boolean  @default(false) // تفعيل القالب الذكي للشهادات
  templateFileId                String? // معرف ملف قالب الشهادة في وحدة التخزين
  primaryColor                  String   @default("#015e63") // اللون الأساسي للمنصة
  secondaryColor                String   @default("#d3bb8b") // اللون الثانوي للمنصة
  whatsappNumber                String? // رقم الدعم الفني (ديناميكي)
  darkModeEnabled               Boolean  @default(false) // تفعيل الوضع المظلم
  requireStudentApplicationFile Boolean  @default(false) // إلزام الجهات برفع ملف PDF
  showTutorialSection           Boolean  @default(true) // إظهار قسم التعليم والدور في الإعدادات
  updatedAt                     DateTime @updatedAt

  @@map("app_settings")
}

// ------------------------------------------------------------
// سجل التدقيق
// ------------------------------------------------------------
model AuditLog {
  id        String      @id @default(cuid())
  userId    String?
  action    AuditAction
  details   Json?
  tenantId  String? // Multi-Tenant — nullable لسجلات مستوى المنصة (SUPER_ADMIN/تنبيهات أمنية)
  timestamp DateTime    @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?   @relation("UserAuditLogs", fields: [userId], references: [id])

  @@index([userId])
  @@index([timestamp])
  @@index([tenantId])
  @@index([tenantId, timestamp])
  @@index([tenantId, action])
  @@map("audit_logs")
}

// ------------------------------------------------------------
// Rate Limiting (منع إساءة الاستخدام — يعمل على Serverless)
// ------------------------------------------------------------
model RateLimit {
  key     String   @id // مفتاح فريد للنقطة
  count   Int      @default(0)
  resetAt DateTime

  @@index([resetAt])
  @@map("rate_limits")
}
